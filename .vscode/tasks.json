{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (Debug)",
            "type": "shell",
            "command": "& 'C:\\Program Files\\CMake\\bin\\cmake.exe' --build build_ninja",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Run",
            "type": "shell",
            "command": ".\\build_ninja\\vs13.exe",
            "dependsOn": "Build (Debug)",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Build & Run",
            "type": "shell",
            "command": "& 'C:\\Program Files\\CMake\\bin\\cmake.exe' --build build_ninja; if ($LASTEXITCODE -eq 0) { .\\build_ninja\\vs13.exe }",
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "CMake Configure",
            "type": "shell",
            "command": "& 'C:\\Program Files\\CMake\\bin\\cmake.exe' -S . -B build_ninja -G Ninja",
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Gen Shaders",
            "type": "shell",
            "command": "C:/Users/nukec/AppData/Local/Programs/Python/Python312/python.exe tools/gen_shaders.py",
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Server Test: Launch Server",
            "type": "shell",
            "command": ".\\build_ninja\\vs13_server.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "servertest"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Server Test: Launch Client 1",
            "type": "shell",
            "command": ".\\build_ninja\\vs13.exe --server localhost:7778",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "servertest"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Server Test: Launch Client 2",
            "type": "shell",
            "command": ".\\build_ninja\\vs13.exe --server localhost:7778",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "servertest"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Server Test",
            "dependsOn": [
                "Build (Debug)",
                "Server Test: Launch Server",
                "Server Test: Launch Client 1",
                "Server Test: Launch Client 2"
            ],
            "dependsOrder": "sequence",
            "group": "test",
            "problemMatcher": []
        }
    ]
}
